{
  "manifest_version": 3,
  "name": "S21 SlotMachine",
  "version": "1.1.0",
  "description": "Автообновление календаря и запись на слоты ревью Школы 21.",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://platform.21-school.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
